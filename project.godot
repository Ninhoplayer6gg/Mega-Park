; Engine configuration file.
; Mega Park - Godot 4.3

config_version=5

[application]

config/name="Mega Park"
config/description="Parque interdimensional de criaturas: construa, incube, evolua e batalhe."
config/version="0.1.0"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.1, 0.13, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameClock="*res://scripts/core/game_clock.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
Economy="*res://scripts/economy/economy.gd"
CreatureRoster="*res://scripts/creatures/creature_roster.gd"
ParkState="*res://scripts/park/park_state.gd"
IncubationManager="*res://scripts/incubation/incubation_manager.gd"
ExpeditionManager="*res://scripts/expeditions/expedition_manager.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
ArenaManager="*res://scripts/battle/arena_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font="res://assets/fonts/PixelifySans.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

